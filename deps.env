# The upstream commits this twin is built against.
#
# Pinned rather than tracked, because both halves move: `microduck_rl` took eighteen commits
# in the two weeks this project was being scoped, and a twin whose body and daemons drift
# independently is a twin whose failures nobody can attribute. `microduck-twin up` clones
# these under the state directory and leaves them alone.
#
# To work against a checkout you already have, point `TWIN_MICRODUCK` or `TWIN_MICRODUCK_RL`
# at it and these are ignored — that is the developer's path, and it is how this project is
# written.

# pollen-robotics/microduck — the daemons. 0.15.0.
MICRODUCK_REF=a9ec4b2079ef8ee7904014089c885bb07d57d63c

# pollen-robotics/microduck_rl — the body, the scenes, the ONNX runtime. develop.
MICRODUCK_RL_REF=2b25a48b08f1f17bc38c90bb03144c81fbd9ed07
